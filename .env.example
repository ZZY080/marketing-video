# Required for image generation (Gemini API)
GEMINI_API_KEY=

# Optional: which model to try first for slide images (default: Nano Banana).
# - Nano Banana (generateContent + image): gemini-2.5-flash-image | gemini-3.1-flash-image-preview | gemini-3-pro-image-preview
#   Docs: https://ai.google.dev/gemini-api/docs/image-generation
# - Imagen (generateImages only): imagen-4.0-generate-001 | imagen-4.0-fast-generate-001 | imagen-4.0-ultra-generate-001 | imagen-3.0-generate-002
#   Docs: https://ai.google.dev/gemini-api/docs/imagen
# scripts/image.ts routes by model id (imagen-* vs gemini-*-image*).
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image

# Required for TTS (MiniMax)
MINIMAX_API_KEY=

# Optional: override media root, default is <repo>/media
# MARKETING_VIDEO_MEDIA_ROOT=/absolute/path/to/media

# Optional: validate tail page must include this URL (default https://www.leadvisor.net)
# MARKETING_VIDEO_REQUIRED_CTA_URL=https://www.leadvisor.net



